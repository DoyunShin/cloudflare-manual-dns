# Cloudflare Record-Scoped DNS Proxy -- environment configuration
#
# Copy this file to `.env` and fill in real values before running
# `docker compose up`. Never commit the resulting `.env` file.

# --- Secrets -----------------------------------------------------------
# PROXY_SECRET_KEY: Fernet key (44-char urlsafe base64) used to encrypt
# stored upstream credentials and cached OAuth tokens at rest.
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MUST be generated once and kept stable across every restart/replica --
# rotating it makes all previously-stored secrets undecryptable.
PROXY_SECRET_KEY=

# Public HTTPS origin used for cookies, CSRF, and OIDC callback URLs.
APP_BASE_URL=https://your-domain.example

# --- Database ------------------------------------------------------------
# DB_URL: SQLAlchemy async URL for the application database (MySQL in prod).
DB_URL=mysql+asyncmy://cfproxy:changeme@mysql:3306/cfproxy

# Credentials consumed by the `mysql` compose service to initialize the
# database and root account. Must match the user/password/db in DB_URL.
MYSQL_DATABASE=cfproxy
MYSQL_USER=cfproxy
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme-root

# --- Redis -----------------------------------------------------------------
# REDIS_URL: connection string used by the application.
REDIS_URL=redis://:changeme-redis@redis:6379/0

# REDIS_PASSWORD: consumed by the `redis` compose service (must match the
# password embedded in REDIS_URL above).
REDIS_PASSWORD=changeme-redis

# --- Cloudflare OAuth --------------------------------------------------
# Register an OAuth client in the Cloudflare dashboard and fill these in.
# Callback: ${APP_BASE_URL}/api/v1/upstream-credentials/cf/callback
CF_OAUTH_CLIENT_ID=
CF_OAUTH_CLIENT_SECRET=
CF_OAUTH_BASE_SCOPES=openid offline_access

# CF_OAUTH_DNS_SCOPE: the DNS-record scope discovered via `discover-scope`
# (or `GET /client/v4/oauth/scopes`); set once known.
CF_OAUTH_DNS_SCOPE=

# --- Web server --------------------------------------------------------
# WEB_CONCURRENCY: gunicorn worker count; each worker owns its own DB pool.
# Size MySQL's max_connections for replicas x WEB_CONCURRENCY x pool size.
WEB_CONCURRENCY=4

# Behind a TLS proxy, set only that proxy's trusted IPs/CIDRs so the login
# rate limiter sees original client addresses. Never trust arbitrary peers.
# FORWARDED_ALLOW_IPS=127.0.0.1,::1

# --- Optional overrides (sane defaults; uncomment to change) -----------
# UPSTREAM_BASE_URL=https://api.cloudflare.com
# CF_OAUTH_ISSUER=https://dash.cloudflare.com
# TOKEN_BRAND=cfsx
# SESSION_TTL_SECONDS=86400
# OAUTH_STATE_TTL=600
# RULES_CACHE_TTL=300
# ACCESS_TOKEN_SKEW=60
